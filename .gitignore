# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...кроме образца: в нём нет секретов, только список переменных с
# объяснением, зачем каждая нужна.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Обработанные фотографии. Оригиналы лежат в ./media, всё остальное
# пересобирается — держать в репозитории смысла нет, только раздувать историю
# бинарниками.
/public/img/
/public/video/
/src/generated/

# База магазина: товары, настройки и — главное — заказы с телефонами и
# адресами клиентов. В репозиторий такому попадать нельзя ни при каких
# обстоятельствах. Бэкап: npm run backup (кладёт копии в var/backups).
/var/

# Журналы заказов прежнего сервиса — по той же причине.
*.jsonl

# IDE и локальные настройки инструментов
/.idea/
.claude/settings.local.json
